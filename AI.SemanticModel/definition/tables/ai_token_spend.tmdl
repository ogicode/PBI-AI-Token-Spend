table ai_token_spend
	lineageTag: abe39a2a-9468-4206-8a0a-88db5a1badda

	measure 'Total Spend' = SUM(ai_token_spend[cost_eur])
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: bd92647f-8f7f-4a01-b79e-a934083e4ee3

	measure 'Cost per Hour Saved' = DIVIDE([Total Spend], SUM(ai_token_spend[hours_saved]))
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 0df01d19-9f84-475f-87cb-9f7c7daa8b0f

	measure ROI = DIVIDE(SUM(ai_token_spend[labour_value_eur]) - [Total Spend], [Total Spend])
		lineageTag: 15b1ea26-b7c1-41f3-ac48-2a189324c72a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Hours Saved' = SUM(ai_token_spend[hours_saved])
		lineageTag: 0b0e12b1-e9cd-460b-a8ca-05b6c3821a20

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Budget Variance %' =
			
			VAR Budget =
			    SUMX(
			        SUMMARIZE(ai_token_spend, ai_token_spend[team_name], ai_token_spend[month_year]),
			        CALCULATE(MAX(ai_token_spend[monthly_budget_eur]))
			    )
			RETURN DIVIDE([Total Spend] - Budget, Budget)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: e880b2dc-f2e1-4751-8a75-3025d10c9d42

	measure 'Cost per Accepted Task' = DIVIDE([Total Spend], SUM(ai_token_spend[tasks_accepted]))
		lineageTag: ba1c4e3c-80af-4d96-9000-93e5b12f3679

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Card - Spend by Model' =
			
			VAR CardW     = 600
			VAR CardH     = 480
			VAR TitleSize = 30
			VAR TitleGap  = 20
			VAR ValueSize = 22
			VAR ValueWidth = 130
			VAR NameSize  = 17
			VAR MetaSize  = 15
			VAR RowPadV   = 13
			VAR RowPadH   = 18
			VAR RowGap    = 10
			VAR AccentW   = 5
			VAR AccentCol = "#426A92"
			VAR RowBg     = "#F3F4F6"
			VAR BarBg     = "#E2E6EB"
			VAR TextDark  = "#172B4D"
			VAR TextMuted = "#5D6878"
			VAR TotalSpend = SUM ( ai_token_spend[cost_eur] )
			VAR CardRows =
			    CONCATENATEX (
			        TOPN (
			            5,
			            SUMMARIZE ( ai_token_spend, ai_token_spend[model_name] ),
			            CALCULATE ( SUM ( ai_token_spend[cost_eur] ) ), DESC
			        ),
			        "<div style='position:relative;background:" & RowBg & ";border-radius:8px;margin-bottom:" & RowGap & "px;overflow:hidden;'>"
			            & "<div style='position:absolute;top:0;left:0;height:100%;width:"
			            & FORMAT ( DIVIDE ( CALCULATE ( SUM ( ai_token_spend[cost_eur] ) ), TotalSpend ) * 100, "0" )
			            & "&#37;;background:" & BarBg & ";'></div>"
			            & "<div style='position:relative;display:flex;align-items:center;border-left:" & AccentW & "px solid " & AccentCol & ";padding:" & RowPadV & "px " & RowPadH & "px;'>"
			            & "<div style='font-size:" & ValueSize & "px;font-weight:600;color:" & TextDark & ";min-width:" & ValueWidth & "px;'>&#8364;"
			            & FORMAT ( CALCULATE ( SUM ( ai_token_spend[cost_eur] ) ) / 1000, "#,##0.0" )
			            & "K</div><div>"
			            & "<div style='font-size:" & NameSize & "px;font-weight:400;color:" & TextDark & ";'>"
			            & ai_token_spend[model_name]
			            & "</div>"
			            & "<div style='font-size:" & MetaSize & "px;font-weight:400;color:" & TextMuted & ";'>"
			            & FORMAT ( DIVIDE ( CALCULATE ( SUM ( ai_token_spend[cost_eur] ) ), TotalSpend ) * 100, "0.0" )
			            & "&#37; of spend</div>"
			            & "</div></div></div>",
			        "",
			        CALCULATE ( SUM ( ai_token_spend[cost_eur] ) ), DESC
			    )
			RETURN
			    "data:image/svg+xml;utf8,"
			        & "<svg xmlns='http://www.w3.org/2000/svg' width='" & CardW & "' height='" & CardH & "'>"
			        & "<foreignObject width='100%' height='100%'>"
			        & "<div xmlns='http://www.w3.org/1999/xhtml' style='font-family:Segoe UI,sans-serif;background:transparent;padding:4px 2px;box-sizing:border-box;height:100%;'>"
			        & "<div style='font-size:" & TitleSize & "px;font-weight:600;color:" & TextDark & ";margin-bottom:" & TitleGap & "px;'>Spend by Model</div>"
			        & CardRows
			        & "</div></foreignObject></svg>"
		lineageTag: 931e1ef8-e603-4fb1-8fb9-5b59e046ab24

	measure 'Last Updated' = FORMAT(NOW(), "dd/MM/yy HH:mm")
		lineageTag: d47855f7-5686-419a-a190-b5bc9a896acf

	measure 'Acceptance Rate' = DIVIDE(SUM(ai_token_spend[tasks_accepted]), SUM(ai_token_spend[tasks_attempted]))
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 577628e0-44fb-4c38-b596-5929d923c596

	measure 'Value Multiple' = DIVIDE(SUM(ai_token_spend[labour_value_eur]), SUM(ai_token_spend[cost_eur]))
		lineageTag: a9c20843-01b1-4005-a091-a2fd18f73252

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cache Rate' = DIVIDE(SUM(ai_token_spend[cached_input_tokens]), SUM(ai_token_spend[input_tokens]))
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: e75eba60-1ae8-4921-95b8-b17ca5acf154

	measure 'Wasted Spend €' = SUM(ai_token_spend[wasted_cost_eur])
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 3501e70d-540d-489d-9ea5-2985fee74102

	measure 'Wasted Spend %' = DIVIDE(SUM(ai_token_spend[wasted_cost_eur]), [Total Spend])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 7f898f5b-fb7c-41bc-95af-a2223834cca8

